{
  "name": "olx-clone",
  "version": "1.0.0",
  "description": "OLX Clone built with Node.js, Express, MongoDB (MERN without React - Vanilla HTML/CSS/JS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "dev": "node server.js",
    "build": "npm run build --prefix client",
